# Copy to stack.env (chmod 600) and fill in. NEVER commit the real file.
# Firefly III core
APP_KEY=base64:REPLACE_WITH_32_BYTE_KEY
APP_URL=https://firefly.home.example
TZ=UTC
TRUSTED_PROXIES=**
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=REPLACE_ME
STATIC_CRON_TOKEN=REPLACE_WITH_32_CHARS
# MariaDB init (only used on first run)
MYSQL_DATABASE=firefly
MYSQL_USER=firefly
MYSQL_PASSWORD=REPLACE_ME
MYSQL_RANDOM_ROOT_PASSWORD=yes
